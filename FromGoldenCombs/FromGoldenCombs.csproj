<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <LangVersion>10</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="assets\wildcrafttree\**" />
    <Compile Remove="bin\**" />
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="assets\wildcrafttree\**" />
    <EmbeddedResource Remove="bin\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="assets\wildcrafttree\**" />
    <None Remove="bin\**" />
    <None Remove="obj\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Blocks\ClaypotHive\ClayHiveTop.cs">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Compile>
    <Compile Update="Blocks\ClaypotHive\RawBroodPot .cs">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Compile>
    <Compile Update="FromGoldenCombs.cs">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Content Include="assets/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Remove="assets\wildcrafttree\**" />
    <Compile Remove="BlockEntities\BlockEntityClaypotHive.cs" />
    <Compile Remove="Blocks\BlockClaypotHive.cs" />
    <Compile Remove="Blocks\BlockHiveTop.cs" />
    <Compile Remove="Blocks\BlockRawClaypotHive .cs" />
    <Content Remove="assets\fromgoldencombs\blocktypes\plushyblock.json" />
    <Content Remove="assets\fromgoldencombs\shapes\block\sittingdrifter.json" />
    <Content Remove="assets\fromgoldencombs\shapes\block\tinydave.json" />
    <None Remove="assets\artofgrowing\croppatch.json" />
    <None Remove="assets\fromgoldencombs\blocktypes\plushyblock.json" />
    <None Remove="assets\fromgoldencombs\config\handbook\fromgoldencombs-pollination.json" />
    <None Remove="assets\fromgoldencombs\lang\de.json" />
    <None Remove="assets\fromgoldencombs\lang\fr.json" />
    <None Remove="assets\fromgoldencombs\shapes\block\sittingdrifter.json" />
    <None Remove="assets\fromgoldencombs\shapes\block\tinydave.json" />
    <None Remove="assets\game\patches\berrybushpatch.json" />
    <None Remove="assets\game\patches\croppatch.json" />
    <None Remove="assets\newworldcrops\patches\croppatch.json" />
    <None Remove="assets\wildcraftfruit\patches\vanilla-berry-patches.json" />
    <None Remove="assets\wildcraftfruit\patches\wildcraftberrypatches.json" />
    <None Remove="modinfo.json" />
    <Content Include="modinfo.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\PublishProfiles\" />
  </ItemGroup>
  <ItemGroup>
    <!-- Core Vintage Story assemblies -->
    <Reference Include="Vintagestory">
      <HintPath>$(VintageStoryPath)\Vintagestory.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)\VintagestoryAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(VintageStoryPath)\VintagestoryLib.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VintagestoryServer">
      <HintPath>$(VintageStoryPath)\VintagestoryServer.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Core game content mods (where most Vintagestory.GameContent types live) -->
    <Reference Include="VSSurvivalMod">
      <HintPath>$(VintageStoryModsDir)\VSSurvivalMod.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(VintageStoryModsDir)\VSEssentials.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VSCreativeMod">
      <HintPath>$(VintageStoryModsDir)\VSCreativeMod.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Common support libs shipped with VS -->
    <Reference Include="0Harmony">
      <HintPath>$(VintageStoryLibDir)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VintageStoryLibDir)\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VintageStoryLibDir)\protobuf-net.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- OpenTK is referenced directly by some code paths -->
    <Reference Include="OpenTK.Core">
      <HintPath>$(VintageStoryLibDir)\OpenTK.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OpenTK.Graphics">
      <HintPath>$(VintageStoryLibDir)\OpenTK.Graphics.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OpenTK.Mathematics">
      <HintPath>$(VintageStoryLibDir)\OpenTK.Mathematics.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OpenTK.Input">
      <HintPath>$(VintageStoryLibDir)\OpenTK.Input.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OpenTK.Windowing.Common">
      <HintPath>$(VintageStoryLibDir)\OpenTK.Windowing.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OpenTK.Windowing.Desktop">
      <HintPath>$(VintageStoryLibDir)\OpenTK.Windowing.Desktop.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OpenTK.Windowing.GraphicsLibraryFramework">
      <HintPath>$(VintageStoryLibDir)\OpenTK.Windowing.GraphicsLibraryFramework.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Content Update="assets\artofgrowing\croppatch.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="assets\fromgoldencombs\blocktypes\ceramicpot\ceramicbroodpot-fancy.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="assets\fromgoldencombs\blocktypes\ceramicpot\ceramicbroodpot-new.json">
